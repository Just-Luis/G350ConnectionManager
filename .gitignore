# ==========================================================
# .NET build output
# ==========================================================
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
publish/
out/
*.user
*.suo
*.userprefs

# ==========================================================
# Operating System Clutter
# ==========================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ==========================================================
# Temporary captures & scratch files
# ==========================================================
# A blanket media rule keeps stray screenshots out of the repo. The README
# images are then re-included one by one, on purpose: a wildcard here would
# publish any image dropped into docs/screenshots, including one that happens to
# show a local file path in the UI.
*.png
*.jpg
*.log
*.tmp
*.avi
*.mp4
!docs/screenshots/home-light.png
!docs/screenshots/home-dark.png
!docs/screenshots/screen-light.png
!docs/screenshots/files.png
!docs/screenshots/console-dark.png
!docs/screenshots/tutorial-home-connected.png
!docs/screenshots/tutorial-network-address.png
!docs/screenshots/tutorial-sharing-panel.png
!docs/screenshots/tutorial-screen-live.png
!docs/screenshots/tutorial-files-roms.png
!docs/screenshots/tutorial-console.png

# ==========================================================
# App assets that must be committed
# ==========================================================
# brand.png, brand_light.png and app.ico are declared as <Resource> in
# G350ConnectionManager.csproj. They must stay tracked, or every clone fails to
# build with "error BG1002: File 'brand.png' cannot be found".
!src/G350ConnectionManager/*.png

# ==========================================================
# IDE files
# ==========================================================
.vscode/
.idea/
*.swp

# ==========================================================
# Test project output
# ==========================================================
tests/**/bin/
tests/**/obj/
