<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>G350ConnectionManager</AssemblyName>
    <RootNamespace>G350ConnectionManager</RootNamespace>

    <Product>G350 Companion</Product>
    <AssemblyTitle>G350 Companion — Battle XP G350 Connection Manager</AssemblyTitle>
    <Company>Just-Luis</Company>
    <Copyright>MIT Licensed</Copyright>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>

    <!-- Shown on the exe itself and in the taskbar/title bar. -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Documentation generation is what lets the compiler validate the XML in
      /// comments and report unused using directives (IDE0005) on build. Without
      it a malformed doc comment or a stale using sits in the tree indefinitely.
      CS1591 (missing doc on a public member) is suppressed: this is an
      application, not a library, and most of its public surface is XAML-driven.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    The window icon is referenced from XAML, so it must be a WPF resource as
    well as the exe icon (ApplicationIcon above only brands the binary).
  -->
  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="brand.png" />
    <Resource Include="brand_light.png" />
  </ItemGroup>

  <!--
    The console-side grabber is embedded in the exe and uploaded to /tmp on each
    capture session, so the device never holds a copy that can drift from the
    app's protocol.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\console\g350_grabber.py"
                      LogicalName="G350ConnectionManager.g350_grabber.py" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ServiceController is not in the base framework; it is needed to report
      whether the ICS service (SharedAccess) is running. Small, first-party.
    -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <!-- Used to ask the console to re-apply its network after ICS moves the PC
         address. See G350Wired/docs/CONSOLE_CONTROL_INTERFACE.md. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <!--
    Self-contained single-file publish (decided in docs/PLAN.md §2).
    Run:  dotnet publish -c Release

    RuntimeIdentifier lives here rather than in the main PropertyGroup so a
    plain `dotnet build` stays framework-dependent (fast, no runtime packs),
    while publish produces the portable single file.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
