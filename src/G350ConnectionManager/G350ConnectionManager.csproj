<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>G350ConnectionManager</AssemblyName>
    <RootNamespace>G350ConnectionManager</RootNamespace>

    <Product>G350 Companion</Product>
    <AssemblyTitle>G350 Companion — Battle XP G350 Connection Manager</AssemblyTitle>
    <Company>Just-Luis</Company>
    <Copyright>MIT Licensed</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Declared at project level (not only in Release) so `restore` produces an
      assets file that already contains the win-x64 target. Without this, a
      restore-then-build sequence (as CI does) fails with NETSDK1047.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!--
    Self-contained single-file publish (decided in docs/PLAN.md §2).
    Run:  dotnet publish -c Release
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
