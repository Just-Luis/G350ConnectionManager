<Application x:Class="G350ConnectionManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme dictionary (Light/Dark) is inserted at runtime by ThemeService. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
