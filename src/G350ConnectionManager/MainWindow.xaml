<Window x:Class="G350ConnectionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G350 Companion"
        Width="1100" Height="680"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="15"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Sidebar ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="14,20">
            <DockPanel>

                <!-- Brand
                     No left margin / no inner padding: in collapsed mode the 36px
                     logo is centred on the same 28px axis the nav icons use, so
                     nothing shifts when the sidebar is toggled. -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BrandLogo" Width="36" Height="36" CornerRadius="10"
                            HorizontalAlignment="Left"
                            Margin="7,0,0,0"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="G"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="G350 Companion"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Battlexp handheld"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Connection pill (bottom) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="ConnectionPill"
                            Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                         Fill="{DynamicResource StatusIdleBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="Not connected"
                                           Margin="8,0,0,0" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail" Text="No console detected"
                                       FontSize="13" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CollapseButton"
                            Height="44" Padding="15,0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Click="CollapseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="CollapseIcon"
                                  Data="{StaticResource IconChevronLeft}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="20" Height="20" Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="CollapseText" Text="Collapse"
                                       Margin="12,0,0,0" FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" IsChecked="True" Tag="Home"
                                 Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHome}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Tag="Network" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconNetwork}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Network &amp; sharing" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavScreen" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Tag="Screen" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconScreen}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Screen" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFiles" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Tag="Files" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFiles}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Files" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavConsole" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Tag="Console" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconConsole}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Console" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                                 GroupName="Nav" Tag="Settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Content host ==================== -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0"/>
    </Grid>
</Window>
