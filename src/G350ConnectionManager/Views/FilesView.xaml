<UserControl x:Class="G350ConnectionManager.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Files"
                              Subtitle="Browse, read and write files on the G350 over SSH."/>

            <!-- SSH connection summary -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{DynamicResource StatusIdleBrush}"/>
                    <TextBlock Grid.Column="1" Text="Not connected via SSH"
                               Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Grid.Column="2" Content="Connect"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"/>
                </Grid>
            </Border>

                <!-- Dual pane -->
            <Grid Margin="0,18,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Local -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" MinWidth="280">
                    <StackPanel>
                        <Border Padding="16,14" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="This PC" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                                <TextBlock Text="Select a folder" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ListBox Height="300" BorderThickness="0" Background="Transparent"
                                 IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- Transfer buttons -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                    <Button Content="Upload →" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="132" Margin="0,0,0,8" IsEnabled="False"/>
                    <Button Content="← Download" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="132" IsEnabled="False"/>
                </StackPanel>

                <!-- Console -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" MinWidth="280">
                    <StackPanel>
                        <Border Padding="16,14" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="G350" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                                <TextBlock Text="/roms" FontSize="13" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ListBox Height="300" BorderThickness="0" Background="Transparent"
                                 IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="SFTP file browsing arrives in Stage 8."
                       FontSize="13" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
