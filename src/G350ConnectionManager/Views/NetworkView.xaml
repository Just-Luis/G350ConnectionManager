<UserControl x:Class="G350ConnectionManager.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Network &amp; sharing"
                              Subtitle="Two steps and your G350 is online."/>

            <!-- ============ Step 1 : IP address ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}">
                            <TextBlock Text="1" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Set the G350 IP address"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Automatic / Manual -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource SegmentGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AutoMode" Content="Automatic"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             GroupName="IpMode" IsChecked="True"
                                             Checked="IpMode_Changed"/>
                                <RadioButton x:Name="ManualMode" Content="Manual"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             GroupName="IpMode"
                                             Checked="IpMode_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Fields -->
                    <Grid x:Name="FieldGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="IP address" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="IpAddressBox" Style="{StaticResource TextInputStyle}"
                                     Text="192.168.7.1" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Subnet mask" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="SubnetBox" Style="{StaticResource TextInputStyle}"
                                     Text="255.255.255.0" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Gateway" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="GatewayBox" Style="{StaticResource TextInputStyle}"
                                     Text="" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ApplyButton" Content="Apply"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0" Click="Apply_Click"/>
                        <Button x:Name="TestButton" Content="Test connection"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Test_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="NetworkHint"
                               Text="Network configuration arrives in Stage 3."
                               FontSize="13" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ Step 2 : Internet sharing ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}">
                            <TextBlock Text="2" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Share your internet"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Give the G350 your PC connection"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Share from" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ShareFromCombo" Style="{StaticResource ThemedComboBoxStyle}" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Share to" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="ShareToCombo" Style="{StaticResource ThemedComboBoxStyle}" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Internet sharing arrives in Stage 4."
                               FontSize="13" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
