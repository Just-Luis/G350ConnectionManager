<UserControl x:Class="G350ConnectionManager.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Network &amp; sharing"
                              Subtitle="Two steps and your G350 is online."/>

            <!-- ============ Step 1 : IP address ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}">
                            <TextBlock Text="1" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Set the G350 IP address"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Current state of the console's adapter -->
                    <Border Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="CurrentDot" Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource StatusIdleBrush}"/>
                                <TextBlock x:Name="CurrentAdapterText" Grid.Column="1"
                                           Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <TextBlock x:Name="CurrentConfigText" FontSize="13" Margin="20,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Automatic / Manual -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource SegmentGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AutoMode" Content="Automatic"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             GroupName="IpMode" IsChecked="True"
                                             Checked="IpMode_Changed"/>
                                <RadioButton x:Name="ManualMode" Content="Manual"
                                             Style="{StaticResource SegmentButtonStyle}"
                                             GroupName="IpMode"
                                             Checked="IpMode_Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ModeHint" Margin="14,0,0,0" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Fields -->
                    <Grid x:Name="FieldGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="IP address" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="IpAddressBox" Style="{StaticResource TextInputStyle}"
                                     Text="192.168.7.1" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Subnet mask" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="SubnetBox" Style="{StaticResource TextInputStyle}"
                                     Text="255.255.255.0" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Gateway" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="GatewayBox" Style="{StaticResource TextInputStyle}"
                                     Text="" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <!-- Before / After preview -->
                    <Border x:Name="DiffBox"
                            Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14" Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="DiffBefore" FontSize="13" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="→" Margin="16,14,16,0" FontSize="16"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="After apply" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="DiffAfter" FontSize="13" TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button x:Name="ApplyButton" Content="Apply"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0" Click="Apply_Click"/>
                        <Button x:Name="RestoreButton" Content="Restore previous"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" Click="Restore_Click"
                                IsEnabled="False"/>
                        <Button x:Name="TestButton" Content="Test connection"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Test_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="NetworkHint" FontSize="13" Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ Step 2 : Internet sharing ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}">
                            <TextBlock Text="2" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Share your internet"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Give the G350 your PC connection"
                               Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                    <!-- ICS status. Reading ICS needs elevation, so nothing is
                         shown until the user explicitly asks for it. -->
                    <Border x:Name="IcsPanel" CornerRadius="10" Padding="14"
                            Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="IcsDot" Grid.Column="0" Width="9" Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource StatusIdleBrush}"/>

                                <TextBlock x:Name="IcsStatusText" Grid.Column="1"
                                           Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"
                                           Text="Internet sharing — not checked"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <Button x:Name="IcsCheckButton" Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Check"
                                        Padding="14,6" FontSize="12.5"
                                        Click="IcsCheck_Click"/>
                            </Grid>

                            <!-- Filled in once a snapshot arrives. -->
                            <StackPanel x:Name="IcsDetail" Visibility="Collapsed" Margin="0,12,0,0">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="8" Padding="12"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Share from"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="IcsSourceText" Grid.Column="1"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" Text="—"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Share to"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="IcsTargetText" Grid.Column="1"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" Text="—"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ICS address"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="IcsScopeText" Grid.Column="1"
                                                       FontSize="13" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="—"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- The .7.x vs .137.x conflict, stated plainly. -->
                                <Border x:Name="IcsConflictBox" Visibility="Collapsed"
                                        Margin="0,10,0,0" CornerRadius="8" Padding="12"
                                        Background="{DynamicResource WarnSoftBrush}"
                                        BorderBrush="{DynamicResource StatusWarnBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="IcsConflictText"
                                               FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>

                                <TextBlock x:Name="IcsConnectionsText"
                                           Margin="0,10,0,0" FontSize="12"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"/>


                            </StackPanel>

                            <!-- The controls live outside IcsDetail on purpose.
                                 That panel stays collapsed until a snapshot has
                                 been read, so anything inside it is invisible
                                 before the first Check - which made sharing look
                                 permanently unavailable. -->
                            <StackPanel x:Name="IcsActions" Margin="0,14,0,0"
                                        Orientation="Horizontal">
                                <Button x:Name="IcsEnableButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Turn on sharing"
                                        Padding="16,8" FontSize="13"
                                        Click="IcsEnable_Click"/>
                                <Button x:Name="IcsDisableButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Turn off sharing"
                                        Margin="10,0,0,0"
                                        Padding="16,8" FontSize="13"
                                        Click="IcsDisable_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                            <!-- Shown while/after the console is told to
                                 re-apply its network settings. -->
                            <Border x:Name="IcsRestartBox" Visibility="Collapsed"
                                    Margin="0,12,0,0" CornerRadius="8" Padding="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="IcsRestartDot" Grid.Column="0"
                                             Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{DynamicResource StatusIdleBrush}"/>
                                    <TextBlock x:Name="IcsRestartText" Grid.Column="1"
                                               Margin="9,0,0,0" FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>

                    <TextBlock x:Name="IcsFooterText"
                               Text="Turning sharing on or off updates the console's network settings automatically."
                               FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ Activity log ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Activity log" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Every change this app makes, with before and after."
                               Style="{StaticResource BodyTextStyle}" Margin="0,4,0,12"/>

                    <Border Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="12" MinHeight="70">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ActivityText" FontSize="12"
                                       FontFamily="Consolas" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
