<UserControl x:Class="G350ConnectionManager.Views.DiagnosticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitleStyle}"
                           VerticalAlignment="Center"/>
                <Button x:Name="TestButton" Grid.Column="1" Content="Test connection"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Test_Click"/>
            </Grid>

            <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyTextStyle}"
                       Margin="0,4,0,12"/>

            <ItemsControl x:Name="StageList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="10" Height="10" VerticalAlignment="Top"
                                     Margin="0,5,0,0"
                                     Fill="{Binding Brush}"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
