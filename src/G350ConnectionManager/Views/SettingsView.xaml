<UserControl x:Class="G350ConnectionManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Settings"
                              Subtitle="Look and feel. Changes apply instantly."/>

            <!-- Theme -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>

                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WhiteTheme" Content="White" GroupName="Theme"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     IsChecked="True" Checked="Theme_Changed"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                        <RadioButton x:Name="BlackTheme" Content="Black" GroupName="Theme"
                                     Style="{StaticResource SegmentButtonStyle}"
                                     Margin="8,0,0,0" Checked="Theme_Changed"
                                     BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Accent -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Highlight color" Style="{StaticResource FieldLabelStyle}"/>

                    <WrapPanel x:Name="AccentPanel" Orientation="Horizontal"/>

                    <TextBlock Text="Used for main buttons, switches and status. Backgrounds stay white or black."
                               FontSize="13" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Start with sidebar collapsed"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Show only icons until you expand it."
                               FontSize="13" Margin="0,4,0,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <CheckBox x:Name="CollapsedCheck" Content="Collapsed on launch"
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              Checked="Collapsed_Changed" Unchecked="Collapsed_Changed"/>
                </StackPanel>
            </Border>

            <!-- Where captures are saved -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Save captures to" Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Text="Screenshots" FontSize="13" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScreenshotFolderBox" Grid.Column="0"
                                 Style="{StaticResource TextInputStyle}" IsReadOnly="True"/>
                        <Button x:Name="ScreenshotFolderButton" Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Padding="11,0" Height="38"
                                ToolTip="Choose screenshot folder"
                                Click="ChooseScreenshotFolder_Click">
                            <Path Data="{StaticResource IconFiles}"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.7" Width="17" Height="17"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Recordings" FontSize="13" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecordingFolderBox" Grid.Column="0"
                                 Style="{StaticResource TextInputStyle}" IsReadOnly="True"/>
                        <Button x:Name="RecordingFolderButton" Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Padding="11,0" Height="38"
                                ToolTip="Choose recording folder"
                                Click="ChooseRecordingFolder_Click">
                            <Path Data="{StaticResource IconFiles}"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.7" Width="17" Height="17"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <Button x:Name="SameFolderButton" Content="Use the same folder for both"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6" FontSize="12.5" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="SameFolder_Click"/>

                    <TextBlock Text="Both default to Pictures\G350 Captures. Recordings are usually much larger than screenshots, so a separate folder or drive is worth considering."
                               FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Console account -->
            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Console account" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="The SSH and SFTP account on the G350. ArkOS ships ark / ark, so these can be left blank."
                               Style="{StaticResource BodyTextStyle}" Margin="0,4,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="ConsoleUserBox" Style="{StaticResource TextInputStyle}"
                             LostFocus="ConsoleAccount_Changed"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="ConsolePasswordBox" Height="38"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" Padding="10,0" VerticalContentAlignment="Center"
                                 LostFocus="ConsoleAccount_Changed"/>

                    <TextBlock x:Name="ConsoleAccountHint"
                               FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
