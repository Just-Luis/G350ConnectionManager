<UserControl x:Class="G350ConnectionManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Your G350"
                              Subtitle="Connect, share internet and capture the screen in a few clicks."/>

            <!-- Live status banner -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="BannerDot" Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource StatusIdleBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="BannerHeadline" Text="Checking connection…"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="BannerDetail" Margin="8,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Test connection"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Test_Click"/>
                </Grid>
            </Border>

            <!--
                Quick actions. The two things a user does every single session,
                in the order they are done: bring the link up, then optionally
                share the PC's connection with it.
            -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ConnectButton" Grid.Column="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Connect"
                            MinWidth="132"
                            Click="Connect_Click"/>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ActionHeadline" Text="Not connected"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ActionDetail"
                                   Text="Plug in the USB cable and switch the console to PC mode."
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleButton x:Name="ShareWifiToggle" Grid.Column="2"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Content="Share Wi-Fi"
                                  VerticalAlignment="Center"
                                  ToolTip="Give the console internet through this PC's Wi-Fi"
                                  Checked="ShareWifi_Changed"
                                  Unchecked="ShareWifi_Changed"/>
                </Grid>
            </Border>

            <!-- Three steps -->
            <UniformGrid Columns="5" Margin="0,18,0,0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border x:Name="CardIcon1" Width="30" Height="30" CornerRadius="8"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="{DynamicResource SoftBrush}"
                                Tag="Network" MouseLeftButtonUp="Card_Click"
                                ToolTip="Open Network">
                            <Path Data="{StaticResource IconNetwork}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  Width="17" Height="17" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Network" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Step1Text" Text="Checking…"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="3,0">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="8"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="{DynamicResource SoftBrush}"
                                Tag="Network" MouseLeftButtonUp="Card_Click"
                                ToolTip="Open Network">
                            <Path Data="{StaticResource IconStream}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  Width="17" Height="17" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Internet sharing" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Step2Text" Text="Checking…"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="8"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="{DynamicResource SoftBrush}"
                                Tag="Screen" MouseLeftButtonUp="Card_Click"
                                ToolTip="Open Screen">
                            <Path Data="{StaticResource IconScreen}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  Width="17" Height="17" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Screen" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Step3Text" Text="Ready"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="8"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="{DynamicResource SoftBrush}"
                                Tag="Files" MouseLeftButtonUp="Card_Click"
                                ToolTip="Open Files">
                            <Path Data="{StaticResource IconFiles}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  Width="17" Height="17" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Files" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Step4Text" Text="—"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="8"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="{DynamicResource SoftBrush}"
                                Tag="Console" MouseLeftButtonUp="Card_Click"
                                ToolTip="Open Console">
                            <Path Data="{StaticResource IconConsole}"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  Width="17" Height="17" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Console" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="Step5Text" Text="—"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Diagnostics -->
            <views:DiagnosticsPanel Margin="0,18,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
