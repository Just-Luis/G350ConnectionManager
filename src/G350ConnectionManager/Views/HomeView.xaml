<UserControl x:Class="G350ConnectionManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Your G350"
                              Subtitle="Connect, share internet and capture the screen in a few clicks."/>

            <!-- Ready banner -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource StatusIdleBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Console not connected"
                               Margin="10,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="· plug in the USB cable and start services on the console"
                               Margin="6,0,0,0" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Three steps -->
            <UniformGrid Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="1" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Network" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Waiting for console" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="3,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="2" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Internet sharing" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Off" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="3" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Screen" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Not streaming" Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Screen quick actions -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Screen" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Take a screenshot, record a clip or start a live stream."
                               Style="{StaticResource BodyTextStyle}" Margin="0,4,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Take screenshot" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" IsEnabled="False"/>
                        <Button Content="Start recording" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0" IsEnabled="False"/>
                        <Button Content="Start streaming" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="Available once the console is connected (Stage 5)."
                               FontSize="13" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
