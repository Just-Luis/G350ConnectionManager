<UserControl x:Class="G350ConnectionManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <views:PageHeader Title="Your G350"
                              Subtitle="Connect, share internet and capture the screen in a few clicks."/>

            <!-- Live status banner -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="BannerDot" Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource StatusIdleBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="BannerHeadline" Text="Checking connection…"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="BannerDetail" Margin="6,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Test connection"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Test_Click"/>
                </Grid>
            </Border>

            <!-- Three steps -->
            <UniformGrid Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="1" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Network" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="Step1Text" Text="Checking…"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="3,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="2" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Internet sharing" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="Step2Text" Text="Checking…"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <Border Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource SoftBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="3" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Screen" Style="{StaticResource SectionTitleStyle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Available in Stage 5"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Diagnostics -->
            <views:DiagnosticsPanel Margin="0,18,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
