<UserControl x:Class="G350ConnectionManager.Views.ScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <views:PageHeader Title="Screen"
                              Subtitle="Capture, record or stream what is on the G350."/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Preview + actions -->
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Height="292" CornerRadius="14"
                            Background="{DynamicResource PreviewVoidBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconScreen}"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  StrokeThickness="1.8" Width="44" Height="44"
                                  Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PreviewLabel"
                                       Text="Live G350 screen"
                                       FontSize="15" Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="Preview arrives in Stage 5"
                                       FontSize="13" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <Button Content="Take screenshot" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0" IsEnabled="False"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Record" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Start streaming" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"/>
                        <TextBlock Text="00:00" Margin="16,0,0,0" FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Settings pane -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="270" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Save to" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="SaveToBox" Style="{StaticResource TextInputStyle}"
                                 Text="%USERPROFILE%\Pictures\G350 Captures"
                                 IsEnabled="False" Margin="0,0,0,16"/>

                        <TextBlock Text="Quality" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Style="{StaticResource SegmentGroupStyle}" HorizontalAlignment="Stretch">
                            <UniformGrid Columns="3" MinWidth="216">
                                <RadioButton Content="Low" GroupName="Quality"
                                             Style="{StaticResource SegmentButtonStyle}"/>
                                <RadioButton Content="Medium" GroupName="Quality" IsChecked="True"
                                             Style="{StaticResource SegmentButtonStyle}"/>
                                <RadioButton Content="High" GroupName="Quality"
                                             Style="{StaticResource SegmentButtonStyle}"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Stream to" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,0"/>
                        <TextBox x:Name="StreamToBox" Style="{StaticResource TextInputStyle}"
                                 Text="http://localhost:8080" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
