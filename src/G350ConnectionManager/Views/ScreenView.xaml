<UserControl x:Class="G350ConnectionManager.Views.ScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,32,28,32">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">

            <views:PageHeader Title="Screen"
                              Subtitle="Capture or stream what is on the G350."/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Preview + actions -->
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border CornerRadius="14"
                            Background="{DynamicResource PreviewVoidBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid MinHeight="292">
                            <StackPanel x:Name="PreviewPlaceholder"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconScreen}"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="1.8" Width="44" Height="44"
                                      Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewLabel"
                                           Text="Live G350 screen"
                                           FontSize="15" Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="PreviewHint"
                                           Text="Start the preview to see the console."
                                           FontSize="13" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>

                            <!-- Frames are drawn here, scaled to fit. -->
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <Button x:Name="ScreenshotButton" Content="Take screenshot"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0" Click="Screenshot_Click"/>
                        <Button x:Name="RecordButton" Content="Record"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0" Click="Record_Click"/>
                        <Button x:Name="PreviewButton" Content="Start preview"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Preview_Click"/>
                        <TextBlock x:Name="PreviewStatus" Margin="16,0,0,0" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Settings pane -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="270" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Save screenshots to" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="SaveToBox" Style="{StaticResource TextInputStyle}"
                                 Margin="0,0,0,6" IsReadOnly="True"/>
                        <Button x:Name="ChooseFolderButton" Content="Choose folder…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6" FontSize="12.5" HorizontalAlignment="Left"
                                Margin="0,0,0,16" Click="ChooseFolder_Click"/>

                        <TextBlock Text="Resolution" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="ResolutionBox" Style="{StaticResource ThemedComboBoxStyle}"
                                  Margin="0,0,0,12" SelectionChanged="Settings_Changed">
                            <ComboBoxItem Content="320 × 240  (fastest)" Tag="320"/>
                            <ComboBoxItem Content="480 × 360  (balanced)" Tag="480"/>
                            <ComboBoxItem Content="640 × 480  (native)" Tag="640" IsSelected="True"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="FpsValue" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="FpsSlider" Minimum="1" Maximum="20" Value="6"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,12" ValueChanged="Fps_Changed"/>

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="JPEG quality" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="QualityValue" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="75"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Margin="0,0,0,12" ValueChanged="Quality_Changed"/>

                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Delay per frame" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="DelayValue" HorizontalAlignment="Right"
                                       FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="DelaySlider" Minimum="0" Maximum="500" Value="0"
                                TickFrequency="25" IsSnapToTickEnabled="True"
                                Margin="0,0,0,8" ValueChanged="Delay_Changed"/>

                        <TextBlock x:Name="RateHint" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Foreground="{DynamicResource TextMutedBrush}"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- Capture history -->
            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Screenshots" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Saved captures open with your default image viewer."
                               Style="{StaticResource BodyTextStyle}" Margin="0,4,0,12"/>
                    <TextBlock x:Name="HistoryText" Text="No screenshots yet."
                               FontSize="12.5" FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
