<UserControl x:Class="G350ConnectionManager.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:G350ConnectionManager.Views">

    <Grid Margin="32,32,28,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- quick commands -->
            <RowDefinition Height="*"/>      <!-- output -->
            <RowDefinition Height="Auto"/>   <!-- input -->
        </Grid.RowDefinitions>

        <views:PageHeader Grid.Row="0"
                          Title="Console"
                          Subtitle="Run commands on the G350 and read the output."/>

        <!-- Quick commands + output tools -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Quick commands" VerticalAlignment="Center"
                       FontSize="12.5" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="ip addr" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12" FontFamily="Consolas"
                        Margin="0,0,6,0" Click="QuickCommand_Click"/>
                <Button Content="df -h" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12" FontFamily="Consolas"
                        Margin="0,0,6,0" Click="QuickCommand_Click"/>
                <Button Content="ps aux" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12" FontFamily="Consolas"
                        Margin="0,0,6,0" Click="QuickCommand_Click"/>
                <Button Content="free -m" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12" FontFamily="Consolas"
                        Margin="0,0,6,0" Click="QuickCommand_Click"/>
                <Button Content="dmesg | tail" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12" FontFamily="Consolas"
                        Click="QuickCommand_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12"
                        Margin="0,0,6,0" Click="Clear_Click"/>
                <Button Content="Copy output" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12"
                        Margin="0,0,6,0" Click="Copy_Click"/>
                <Button Content="Save log" Style="{StaticResource SecondaryButtonStyle}"
                        Height="32" Padding="13,0" FontSize="12"
                        Click="SaveLog_Click"/>
            </StackPanel>
        </Grid>

        <!-- Output -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12"
                Background="#050505" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ScrollViewer x:Name="OutputScroll" VerticalScrollBarVisibility="Auto"
                          Padding="16,14" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="OutputText"
                           FontFamily="Consolas" FontSize="13"
                           TextWrapping="NoWrap"
                           Foreground="#D4D4D4"
                           Text="Ready. Type a command below and press Enter."/>
            </ScrollViewer>
        </Border>

        <!-- Input -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10"
                    Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="$" VerticalAlignment="Center"
                               Margin="14,0,0,0" FontFamily="Consolas" FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBox x:Name="CommandBox" Grid.Column="1"
                             Margin="10,0,0,0" Height="40" BorderThickness="0"
                             Background="Transparent" VerticalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             KeyDown="CommandBox_KeyDown"/>
                </Grid>
            </Border>

            <Button x:Name="RunButton" Grid.Column="1" Content="Run"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="86" Height="40" Margin="10,0,0,0" Click="Run_Click"/>

            <Button x:Name="StopButton" Grid.Column="2" Content="Stop"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="86" Height="40" Margin="8,0,0,0"
                    IsEnabled="False" Click="Stop_Click"/>
        </Grid>
    </Grid>
</UserControl>
