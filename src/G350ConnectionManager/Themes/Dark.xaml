<!--
  Dark theme — tokens extracted verbatim from the Battlexp G350 Companion mock
  (boards: Home / Screen / Settings / Files, "Black" variants).

  Accent-related brushes are supplied at runtime by ThemeService.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush"  Color="#0B0B0B"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#151515"/>
    <SolidColorBrush x:Key="SidebarBrush"        Color="#151515"/>
    <SolidColorBrush x:Key="RaisedBrush"         Color="#151515"/>
    <SolidColorBrush x:Key="PreviewVoidBrush"    Color="#000000"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#2A2A2A"/>
    <SolidColorBrush x:Key="DividerBrush"        Color="#232323"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#A3A3A3"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="#B7B7B7"/>

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOkBrush"       Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusWarnBrush"     Color="#F59E0B"/>
    <!-- 20% tint of the warn colour, for callout backgrounds. -->
    <SolidColorBrush x:Key="WarnSoftBrush"       Color="#F59E0B33"/>
    <SolidColorBrush x:Key="StatusErrorBrush"    Color="#EF5350"/>
    <SolidColorBrush x:Key="StatusIdleBrush"     Color="#6B6B6B"/>

    <!-- Nav button states -->
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#232323"/>

</ResourceDictionary>
