<!--
  Icon geometries — transcribed from the mock's inline SVG paths
  (22x22 viewBox, stroke-width 1.8, round caps/joins).
  Used with the IconPath style in Controls.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- M3 11l9-8 9 8  /  M5 10v10h14V10 -->
    <Geometry x:Key="IconHome">M3,11 L12,3 L21,11 M5,10 L5,20 L19,20 L19,10</Geometry>

    <!-- circle r9 + meridian paths -->
    <Geometry x:Key="IconNetwork">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M3,12 L21,12 M12,3 C15,6 15,18 12,21 M12,3 C9,6 9,18 12,21</Geometry>

    <!-- rect 18x12 r2 + stand -->
    <Geometry x:Key="IconScreen">M5,4 L19,4 A2,2 0 0 1 21,6 L21,14 A2,2 0 0 1 19,16 L5,16 A2,2 0 0 1 3,14 L3,6 A2,2 0 0 1 5,4 Z M8,20 L16,20 M12,16 L12,20</Geometry>

    <!-- folder outline -->
    <Geometry x:Key="IconFiles">M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z</Geometry>

    <!-- sliders: horizontal rules + three knobs -->
    <Geometry x:Key="IconSettings">M4,6 L14,6 M18,6 L20,6 M4,12 L4,12 M4,12 L8,12 M12,12 L20,12 M4,18 L16,18 M20,18 L20,18</Geometry>

    <!-- chevron left (collapse toggle) -->
    <Geometry x:Key="IconChevronLeft">M15,6 L9,12 L15,18</Geometry>

    <!-- chevron right (expand toggle) -->
    <Geometry x:Key="IconChevronRight">M9,6 L15,12 L9,18</Geometry>

    <!-- camera (screenshot) -->
    <Geometry x:Key="IconCamera">M3,8 A2,2 0 0 1 5,6 L7,6 L8.5,4 L15.5,4 L17,6 L19,6 A2,2 0 0 1 21,8 L21,18 A2,2 0 0 1 19,20 L5,20 A2,2 0 0 1 3,18 Z M12,9 A4,4 0 1 1 12,17 A4,4 0 1 1 12,9</Geometry>

    <!-- record dot -->
    <Geometry x:Key="IconRecord">M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7</Geometry>

    <!-- broadcast -->
    <Geometry x:Key="IconStream">M12,11 A1.6,1.6 0 1 1 12,14.2 A1.6,1.6 0 1 1 12,11 M7.5,8 A6.5,6.5 0 0 0 7.5,17 M16.5,8 A6.5,6.5 0 0 1 16.5,17</Geometry>

</ResourceDictionary>
