<!--
  Light theme — tokens extracted verbatim from the Battlexp G350 Companion mock
  (boards: Home / Network / Settings / Files, "White" variants).

  Accent-related brushes (AccentBrush, OnAccentBrush, SoftBrush) are NOT defined
  here: ThemeService recomputes them at runtime from the user's chosen highlight
  colour, exactly like the mock's {{accent}} / {{onAccent}} / {{soft}} template.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush"  Color="#F5F5F5"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RaisedBrush"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PreviewVoidBrush"    Color="#EFEFEF"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DividerBrush"        Color="#EDEDED"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#111111"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#5F5F5F"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="#8A8A8A"/>

    <!-- Status -->
    <SolidColorBrush x:Key="StatusOkBrush"       Color="#16A34A"/>
    <SolidColorBrush x:Key="StatusWarnBrush"     Color="#D97706"/>
    <!-- 20% tint of the warn colour, for callout backgrounds. -->
    <SolidColorBrush x:Key="WarnSoftBrush"       Color="#D9770633"/>
    <SolidColorBrush x:Key="StatusErrorBrush"    Color="#B00020"/>
    <SolidColorBrush x:Key="StatusIdleBrush"     Color="#9A9A9A"/>

    <!-- Nav button states -->
    <SolidColorBrush x:Key="NavHoverBrush"       Color="#F0F0F0"/>

</ResourceDictionary>
